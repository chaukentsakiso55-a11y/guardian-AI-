<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<title>GuardianAI</title>
<style>
:root{--bg:#010407;--bg2:#04101a;--panel:rgba(6,18,29,.82);--panel2:rgba(8,28,42,.88);--cyan:#62f5ff;--blue:#008cff;--ice:#e9fdff;--muted:#7fa8b8;--line:rgba(98,245,255,.18);--line2:rgba(98,245,255,.42);--green:#61ffc0;--warn:#ffd36d;--danger:#ff668b;--shadow:0 26px 80px rgba(0,93,178,.18),inset 0 1px 0 rgba(255,255,255,.03)}
*{box-sizing:border-box}html{background:#010407}body{margin:0;min-height:100vh;color:var(--ice);font:14px Inter,system-ui,-apple-system,Segoe UI,sans-serif;background:radial-gradient(circle at 12% 0,rgba(0,160,255,.18),transparent 30%),radial-gradient(circle at 86% 16%,rgba(0,92,255,.12),transparent 24%),linear-gradient(180deg,#010407,#03101b 55%,#010407);overflow-x:hidden}
body:before{content:"";position:fixed;inset:0;pointer-events:none;background-image:linear-gradient(rgba(68,186,255,.04) 1px,transparent 1px),linear-gradient(90deg,rgba(68,186,255,.04) 1px,transparent 1px);background-size:48px 48px;mask-image:linear-gradient(#000,transparent 82%)}
button,input,textarea{font:inherit}button{cursor:pointer}
.shell{min-height:100vh;display:grid;grid-template-columns:236px 1fr}aside{position:sticky;top:0;height:100vh;padding:20px 14px;background:linear-gradient(180deg,rgba(2,8,14,.97),rgba(2,7,12,.91));border-right:1px solid var(--line);backdrop-filter:blur(20px);z-index:10}
.brand{display:flex;align-items:center;gap:11px;padding:4px 7px 24px}.mini-logo{width:48px;height:48px;border-radius:15px;overflow:hidden;border:1px solid var(--line2);box-shadow:0 0 28px rgba(0,167,255,.28);background:#000}.mini-logo img{width:100%;height:100%;object-fit:cover}.brand b{display:block;letter-spacing:1.7px}.brand small{color:var(--muted);font-size:9px;letter-spacing:1px}
.nav{display:grid;gap:7px}.nav button{border:1px solid transparent;background:transparent;color:#7299aa;padding:13px 14px;border-radius:14px;text-align:left;transition:.2s}.nav button.active{color:white;background:linear-gradient(90deg,rgba(0,157,255,.16),rgba(0,157,255,.035));border-color:var(--line);box-shadow:inset 3px 0 0 var(--cyan)}.nav button span{color:var(--cyan);margin-right:9px}
.side-status{position:absolute;left:14px;right:14px;bottom:18px;padding:13px;border:1px solid var(--line);border-radius:17px;background:rgba(5,19,30,.72)}.side-status i{display:inline-block;width:8px;height:8px;background:var(--green);border-radius:50%;box-shadow:0 0 12px var(--green);margin-right:7px}
main{padding:22px 26px 90px;min-width:0}.top{display:flex;justify-content:space-between;align-items:center;gap:12px;margin-bottom:18px}.crumb{color:var(--muted);font-size:12px}.top button{border:1px solid var(--line);background:rgba(5,20,32,.75);color:#dffcff;border-radius:999px;padding:9px 13px}
.page{display:none;animation:in .25s ease}.page.active{display:block}@keyframes in{from{opacity:0;transform:translateY(7px)}to{opacity:1;transform:none}}
.hero,.card,.metric{border:1px solid var(--line);background:linear-gradient(180deg,rgba(7,23,37,.86),rgba(3,11,19,.78));box-shadow:var(--shadow);backdrop-filter:blur(18px)}.hero{min-height:315px;border-radius:28px;padding:30px;overflow:hidden;position:relative}.hero:after{content:"";position:absolute;right:-110px;top:-130px;width:420px;height:420px;border-radius:50%;background:radial-gradient(circle,rgba(0,192,255,.22),rgba(0,110,255,.06) 42%,transparent 70%)}
.hero-grid{position:relative;z-index:2;display:grid;grid-template-columns:1.12fr .88fr;gap:22px;align-items:center}.kicker{font-size:10px;letter-spacing:2px;color:var(--cyan)}h1{font-size:46px;line-height:.98;letter-spacing:-2px;margin:15px 0 13px}h1 em{font-style:normal;color:var(--cyan);text-shadow:0 0 24px rgba(98,245,255,.32)}.hero p,.muted{color:var(--muted);line-height:1.7}.hero-actions{display:flex;gap:9px;flex-wrap:wrap;margin-top:20px}.primary,.ghost,.danger{border-radius:13px;padding:12px 16px;font-weight:800}.primary{border:0;background:linear-gradient(135deg,#9af9ff,#13baff);color:#001018;box-shadow:0 0 28px rgba(0,185,255,.22)}.ghost{border:1px solid var(--line2);background:rgba(0,155,255,.06);color:#e9fdff}.danger{border:1px solid rgba(255,102,139,.24);background:rgba(255,102,139,.07);color:#ffc0d1}
.core{justify-self:center;width:300px;aspect-ratio:1;position:relative;display:grid;place-items:center}.ring{position:absolute;inset:3%;border:1px solid rgba(98,245,255,.25);border-radius:50%;box-shadow:0 0 50px rgba(0,160,255,.12),inset 0 0 45px rgba(0,160,255,.06);animation:spin 18s linear infinite}.ring:before,.ring:after{content:"";position:absolute;width:8px;height:8px;border-radius:50%;background:var(--cyan);box-shadow:0 0 16px var(--cyan)}.ring:before{top:12%;left:18%}.ring:after{right:8%;bottom:26%}@keyframes spin{to{transform:rotate(360deg)}}.pulse-art{position:relative;width:215px;height:215px;border-radius:25px;overflow:hidden;background:#000;border:1px solid rgba(98,245,255,.32);box-shadow:0 0 45px rgba(0,143,255,.24),0 0 90px rgba(0,97,255,.12)}.pulse-art img{width:100%;height:100%;object-fit:cover}
.metrics{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-top:14px}.metric{border-radius:19px;padding:17px}.metric b{display:block;font-size:24px;color:var(--cyan)}.metric small{color:var(--muted)}.grid2{display:grid;grid-template-columns:1.15fr .85fr;gap:14px;margin-top:14px}.card{border-radius:21px;padding:19px}.card h3{margin:0 0 14px}.row{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:12px 0;border-bottom:1px solid rgba(255,255,255,.05)}.row:last-child{border-bottom:0}.row small{display:block;color:var(--muted);margin-top:3px}.state{font-size:9px;letter-spacing:1px;color:var(--green)}.dot{width:9px;height:9px;border-radius:50%;background:var(--green);box-shadow:0 0 13px var(--green);display:inline-block;margin-right:8px}
.section-head{display:flex;justify-content:space-between;align-items:end;gap:14px;margin:8px 0 17px}.section-head h2{font-size:32px;margin:0}.badge{font-size:9px;letter-spacing:1.2px;color:var(--cyan);border:1px solid var(--line);padding:6px 9px;border-radius:999px;background:rgba(98,245,255,.04)}
.ai{display:grid;grid-template-columns:1fr 290px;gap:14px}.chat{min-height:620px;display:flex;flex-direction:column}.chat-body{flex:1;display:flex;flex-direction:column;gap:10px;overflow:auto}.msg{max-width:82%;padding:13px 14px;border-radius:17px;line-height:1.55}.msg.ai{align-self:flex-start;background:rgba(0,157,255,.07);border:1px solid var(--line)}.msg.user{align-self:flex-end;background:rgba(0,157,255,.18);border:1px solid rgba(98,245,255,.24)}.composer{display:flex;gap:8px;margin-top:13px}.composer textarea{flex:1;resize:none;min-height:48px;max-height:100px;border:1px solid var(--line);background:#05131f;color:white;border-radius:14px;padding:13px;outline:none}.composer button{border:0;border-radius:13px;background:var(--cyan);color:#001018;font-weight:900;padding:0 17px}
.toggle{width:45px;height:25px;border-radius:99px;background:#0b2433;border:1px solid var(--line);padding:3px;transition:.2s}.toggle:after{content:"";display:block;width:17px;height:17px;border-radius:50%;background:#577787;transition:.2s}.toggle.on{background:rgba(0,171,255,.18);border-color:rgba(98,245,255,.45)}.toggle.on:after{transform:translateX(18px);background:var(--cyan);box-shadow:0 0 13px var(--cyan)}
.auth-overlay{position:fixed;inset:0;z-index:100;display:none;place-items:center;padding:18px;background:rgba(0,0,0,.78);backdrop-filter:blur(15px)}.auth-overlay.show{display:grid}.auth-shell{width:min(850px,94vw);display:grid;grid-template-columns:42% 58%;border-radius:34px;overflow:hidden;background:#071c19;border:1px solid rgba(103,255,217,.22);box-shadow:0 36px 120px rgba(0,0,0,.78),0 0 70px rgba(33,255,194,.08);position:relative}.close{position:absolute;right:15px;top:15px;z-index:5;width:34px;height:34px;border-radius:50%;border:1px solid rgba(95,255,210,.18);background:rgba(5,18,17,.8);color:#b8fff0}
.lamp-zone{min-height:555px;position:relative;overflow:hidden;background:linear-gradient(180deg,#020a09,#061a17);border-right:1px solid rgba(113,255,225,.13)}.lamp{position:absolute;top:-5px;left:50%;transform:translateX(-50%);width:150px;height:105px}.lamp:before{content:"";position:absolute;left:72px;top:0;width:5px;height:48px;background:#1e2c29}.lamp:after{content:"";position:absolute;left:37px;top:45px;width:78px;height:48px;border-radius:50% 50% 12px 12px;background:linear-gradient(#233b36,#0e201c);box-shadow:0 10px 50px rgba(85,255,211,.15)}.beam{position:absolute;top:88px;left:50%;transform:translateX(-50%);width:270px;height:360px;clip-path:polygon(42% 0,58% 0,100% 100%,0 100%);background:linear-gradient(180deg,rgba(92,255,217,.25),rgba(52,255,207,.045) 52%,transparent)}.auth-art{position:absolute;top:135px;left:50%;transform:translateX(-50%);width:230px;height:230px;border-radius:28px;overflow:hidden;background:#000;border:1px solid rgba(104,255,221,.22);box-shadow:0 0 50px rgba(59,255,211,.18)}.auth-art img{width:100%;height:100%;object-fit:cover}.lamp-copy{position:absolute;left:27px;right:27px;bottom:30px}.lamp-copy b{font-size:22px}.lamp-copy p{color:#789b92;font-size:11px;line-height:1.6}
.auth-panel{padding:48px 42px 34px;background:linear-gradient(155deg,rgba(23,38,39,.98),rgba(8,23,23,.99));position:relative}.auth-panel h2{font-size:32px;margin:0}.auth-panel h2 strong{color:#5affd2}.auth-panel>p{color:#aabbb6;font-size:11px;margin:6px 0 20px}.field{margin:11px 0}.field label{display:block;font-size:9px;letter-spacing:1.2px;color:#789c93;margin-bottom:6px}.field input{width:100%;height:42px;border:1px solid rgba(91,255,216,.20);border-radius:7px;background:#081b19;color:white;padding:0 12px;outline:none}.field input:focus{border-color:#5affd2;box-shadow:0 0 0 3px rgba(90,255,210,.06)}.register-only{display:none}.auth-shell.register .register-only{display:block}.submit{width:100%;height:42px;border:0;border-radius:7px;background:linear-gradient(90deg,#35e3b2,#67ffd9);color:#052019;font-weight:900;letter-spacing:.8px;margin-top:14px;box-shadow:0 0 22px rgba(67,255,211,.17)}.or{display:flex;align-items:center;gap:8px;color:#66867f;font-size:9px;margin:12px 0}.or:before,.or:after{content:"";height:1px;flex:1;background:rgba(255,255,255,.08)}.social{display:grid;grid-template-columns:1fr 1fr;gap:8px}.social button,.anon{height:39px;border-radius:7px;border:1px solid rgba(90,255,210,.14);background:#0a211e;color:#d9fff6}.anon{width:100%;margin-top:8px}.switch{font-size:10px;color:#789c93;text-align:center;margin-top:13px}.switch button{border:0;background:none;color:#5affd2;font-weight:800}
.mobile-nav{display:none}.toast{position:fixed;right:18px;bottom:18px;z-index:150;max-width:320px;padding:12px 14px;border-radius:14px;border:1px solid var(--line2);background:#061520;color:white;box-shadow:0 20px 55px rgba(0,0,0,.45);opacity:0;transform:translateY(10px);pointer-events:none;transition:.2s}.toast.show{opacity:1;transform:none}
@media(max-width:920px){.shell{grid-template-columns:80px 1fr}aside .brand div:last-child,.nav button:not(.active){font-size:0}.brand{justify-content:center}.side-status{display:none}.hero-grid,.grid2,.ai{grid-template-columns:1fr}.core{width:250px}.metrics{grid-template-columns:repeat(2,1fr)}}
@media(max-width:680px){.shell{display:block}aside{display:none}main{padding:15px 13px 88px}.hero{padding:21px;border-radius:22px}h1{font-size:36px}.core{width:220px}.pulse-art{width:165px;height:165px}.metrics{grid-template-columns:1fr 1fr}.auth-shell{grid-template-columns:1fr;max-height:94vh;overflow:auto}.lamp-zone{min-height:255px;border-right:0;border-bottom:1px solid rgba(113,255,225,.13)}.lamp{transform:translateX(-50%) scale(.7);transform-origin:top center}.beam{height:190px;width:220px}.auth-art{top:88px;width:125px;height:125px;border-radius:18px}.lamp-copy{bottom:10px;text-align:center}.lamp-copy b{font-size:16px}.lamp-copy p{display:non